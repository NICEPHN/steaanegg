        ConfirmKeyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        task.wait(2)
        ConfirmKeyBtn.Text = "Xác nhận Key"
        ConfirmKeyBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 80)
