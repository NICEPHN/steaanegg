        setclipboard(linkKey)
        GetKeyBtn.Text = "Đã Copy Link Key!"
    else
        GetKeyBtn.Text = "Link đã tạo"
    end
    task.wait(2)
    GetKeyBtn.Text = "Get Key"
end)

-- Cài đặt Key chính xác là UPDATE1PROVIP ở đây
