    if KeyBox.Text == "UPDATE1PROVIP" then
        isKeyValid = true
        ConfirmKeyBtn.Text = "Thành Công!"
        ConfirmKeyBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 100)
    else
        isKeyValid = false
