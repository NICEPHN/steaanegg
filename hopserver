end)

local function SafeHop()
    if not isKeyValid then
        ConfirmKeyBtn.Text = "Hãy Nhập Key!"
        task.wait(1.5)
        ConfirmKeyBtn.Text = "Xác nhận Key"
        return
    end

    pcall(function()
        local maxLimit = tonumber(TextBox.Text) or 1
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        
        if success then
            local data = HttpService:JSONDecode(result)
            if data and data.data then
                local validServers = {}
                for _, s in ipairs(data.data) do
                    if s.playing <= maxLimit and s.playing > 0 and s.id ~= game.JobId then
                        table.insert(validServers, s.id)
                    end
                end
                
                if #validServers > 0 then
                    local randomTarget = validServers[math.random(1, #validServers)]
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, randomTarget, Players.LocalPlayer)
                    return
                end
            end
        end
        
        TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
    end)
end

HopSekaliBtn.MouseButton1Click:Connect(function()
    SafeHop()
end)

local autoHopActive = false
AutoHopBtn.MouseButton1Click:Connect(function()
    if not isKeyValid then
        ConfirmKeyBtn.Text = "Hãy Nhập Key!"
        task.wait(1.5)
        ConfirmKeyBtn.Text = "Xác nhận Key"
        return
    end

    autoHopActive = not autoHopActive
    if autoHopActive then
        AutoHopBtn.Text = "Auto Hop: ON"
        AutoHopBtn.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
    else
        AutoHopBtn.Text = "Auto Hop: OFF"
        AutoHopBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 70)
    end
end)

task.spawn(function()
    while ScreenGui.Parent do
        task.wait(5)
        if autoHopActive and isKeyValid then
            pcall(function()
                local maxLimit = tonumber(TextBox.Text) or 1
                if #Players:GetPlayers() > maxLimit then
                    SafeHop()
                end
            end)
        end
    end
end)
