-- ==================== HÀM MỞ MENU CHÍNH ====================
local function OpenMainHub()
    KeyGui:Destroy()

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "NiceXHubUI"
    ScreenGui.Parent = PlayerGui
    ScreenGui.ResetOnSpawn = false

    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    MainFrame.BorderSizePixel = 0
    MainFrame.Position = UDim2.new(0.05, 0, 0.15, 0)
    MainFrame.Size = UDim2.new(0, 240, 0, 195)
    MainFrame.Active = true
    MainFrame.Draggable = true
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = MainFrame
    TitleLabel.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    TitleLabel.BorderSizePixel = 0
    TitleLabel.Size = UDim2.new(1, 0, 0, 36)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = "  ⚡ Nice X Steal An Egg"
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", TitleLabel).CornerRadius = UDim.new(0, 8)

    local MarkerBtn = Instance.new("TextButton")
    MarkerBtn.Parent = MainFrame
    MarkerBtn.BackgroundColor3 = Color3.fromRGB(0, 115, 230)
    MarkerBtn.BorderSizePixel = 0
    MarkerBtn.Position = UDim2.new(0.05, 0, 0.23, 0)
    MarkerBtn.Size = UDim2.new(0.9, 0, 0, 38)
    MarkerBtn.Font = Enum.Font.GothamBold
    MarkerBtn.Text = "🗑️ Remove Marker"
    MarkerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    MarkerBtn.TextSize = 13
    Instance.new("UICorner", MarkerBtn).CornerRadius = UDim.new(0, 6)

    local GoBtn = Instance.new("TextButton")
    GoBtn.Parent = MainFrame
    GoBtn.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    GoBtn.BorderSizePixel = 0
    GoBtn.Position = UDim2.new(0.05, 0, 0.45, 0)
    GoBtn.Size = UDim2.new(0.9, 0, 0, 38)
    GoBtn.Font = Enum.Font.GothamBold
    GoBtn.Text = "🏃 Go To Marker"
    GoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    GoBtn.TextSize = 13
    Instance.new("UICorner", GoBtn).CornerRadius = UDim.new(0, 6)

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Parent = MainFrame
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Position = UDim2.new(0.05, 0, 0.67, 0)
    ToggleBtn.Size = UDim2.new(0.9, 0, 0, 38)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Text = "⚡ Bypass Speed: ON 🟢"
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.TextSize = 13
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 6)

    local CreditLabel = Instance.new("TextLabel")
    CreditLabel.Parent = MainFrame
    CreditLabel.BackgroundTransparency = 1
    CreditLabel.Position = UDim2.new(0.05, 0, 0.88, 0)
    CreditLabel.Size = UDim2.new(0.9, 0, 0, 18)
    CreditLabel.Font = Enum.Font.Gotham
    CreditLabel.Text = "Nice X Pro Anti Ban"
    CreditLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
    CreditLabel.TextSize = 10

    -- Logic Hub
    local savedPos = nil
    local speedBypass = true
    local isBypassing = false

    MarkerBtn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            if not savedPos then
                savedPos = root.CFrame
                MarkerBtn.Text = "🗑️ Remove Marker"
            else
                savedPos = nil
                MarkerBtn.Text = "📍 Set Marker"
            end
        end
    end)

    ToggleBtn.MouseButton1Click:Connect(function()
        speedBypass = not speedBypass
        if speedBypass then
            ToggleBtn.Text = "⚡ Bypass Speed: ON 🟢"
        else
            ToggleBtn.Text = "⚡ Bypass Speed: OFF 🔴"
        end
    end)

    GoBtn.MouseButton1Click:Connect(function()
        if isBypassing then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")
        
        if root and savedPos and humanoid then
            isBypassing = true
            task.spawn(function()
                local startPos = root.Position
                local targetPos = Vector3.new(savedPos.Position.X, startPos.Y, savedPos.Position.Z)
                local dist = (startPos - targetPos).Magnitude
                local speed = speedBypass and 350 or 200
                local duration = math.clamp(dist / speed, 0.5, 10)
                local elapsed = 0
                
                local antiDeathConn = RunService.Stepped:Connect(function()
                    if humanoid and humanoid.Parent then
                        humanoid.Health = humanoid.MaxHealth
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
                    end
                end)
                
                local runConn
                runConn = RunService.Heartbeat:Connect(function(dt)
                    if not root or not root.Parent then
                        if runConn then runConn:Disconnect() end
                        if antiDeathConn then antiDeathConn:Disconnect() end
                        isBypassing = false
                        GoBtn.Text = "🏃 Go To Marker"
                        return
                    end
                    
                    elapsed = elapsed + dt
                    local timeLeft = math.ceil(duration - elapsed)
                    if timeLeft > 0 then
                        GoBtn.Text = "🏃 Running... " .. timeLeft .. "s"
                    else
                        GoBtn.Text = "🏃 Running..."
                    end
                    
                    local alpha = math.clamp(elapsed / duration, 0, 1)
                    local currentPos = startPos:Lerp(targetPos, alpha)
                    root.CFrame = CFrame.new(currentPos, targetPos)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    
                    if alpha >= 1 then
                        if runConn then runConn:Disconnect() end
                        if antiDeathConn then antiDeathConn:Disconnect() end
                        
                        root.CFrame = savedPos
                        if humanoid then
                            humanoid.Health = humanoid.MaxHealth
                            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                        end
                        
                        GoBtn.Text = "✅ Success!"
                        task.wait(1)
                        GoBtn.Text = "🏃 Go To Marker"
                        isBypassing = false
                    end
                end)
            end)
        else
            GoBtn.Text = "❌ Chưa có Marker!"
            task.wait(1)
            GoBtn.Text = "🏃 Go To Marker"
        end
    end)
end

-- Kiểm tra Key khi bấm nút Xác Nhận
SubmitBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == "UPDATEMENU1SOON" then
        StatusLabel.TextColor3 = Color3.fromRGB(40, 167, 69)
        StatusLabel.Text = "Key chính xác! Đang mở Hub..."
        task.wait(0.5)
        OpenMainHub()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(220, 53, 69)
        StatusLabel.Text = "Sai Key rồi boss man ơi!"
    end
end)
